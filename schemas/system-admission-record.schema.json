{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpex.systems/schemas/system-admission-record.schema.json",
  "title": "XPeX Enterprise System Admission Record",
  "type": "object",
  "required": [
    "schema_version",
    "admission_id",
    "system_id",
    "gate_states",
    "risk_tier",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "admission_id": {
      "type": "string",
      "minLength": 8
    },
    "system_id": {
      "type": "string",
      "minLength": 4
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "gate_states": {
      "type": "object",
      "required": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7"
      ],
      "properties": {
        "G0": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        },
        "G1": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        },
        "G2": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        },
        "G3": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        },
        "G4": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        },
        "G5": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        },
        "G6": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        },
        "G7": {
          "enum": [
            "PASS",
            "BLOCKED",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independent_verifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
