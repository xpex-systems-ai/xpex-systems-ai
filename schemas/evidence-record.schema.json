{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpex.systems/schemas/evidence-record.schema.json",
  "title": "XPeX Governance Evidence Record",
  "type": "object",
  "required": [
    "evidence_id",
    "claim",
    "source_type",
    "verification_status",
    "observed_at"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "control_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "RUNTIME",
        "PROVIDER_API",
        "SOURCE_CODE",
        "TEST",
        "HUMAN_ATTESTATION",
        "INFERENCE"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "enum": [
        "DISCOVERED",
        "OBSERVED",
        "CORROBORATED",
        "VERIFIED",
        "SUPERSEDED",
        "INVALIDATED"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
