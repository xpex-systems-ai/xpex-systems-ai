{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpex.systems/schemas/agent-manifest.schema.json",
  "title": "XPeX Agent Manifest",
  "type": "object",
  "required": [
    "agent_id",
    "name",
    "owner",
    "risk_tier",
    "purpose",
    "capabilities",
    "denied_capabilities",
    "human_approval",
    "limits",
    "status"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "denied_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "approved_data_classes": {
      "type": "array",
      "items": {
        "enum": [
          "D0",
          "D1",
          "D2",
          "D3",
          "D4"
        ]
      },
      "uniqueItems": true
    },
    "approved_environments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "human_approval": {
      "type": "object",
      "required": [
        "required_for"
      ],
      "properties": {
        "required_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_steps",
        "max_runtime_seconds",
        "max_retries"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "daily_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "kill_switch": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "PAUSED",
        "RETIRED"
      ]
    },
    "last_reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
